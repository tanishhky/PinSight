# PinSight — Environment variables template
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ── Data providers ──────────────────────────────────────────────────────────
# Tradier sandbox (free with account): https://developer.tradier.com/
TRADIER_API_KEY=
TRADIER_ENV=sandbox            # sandbox | live

# Polygon.io free tier (limited): https://polygon.io/
POLYGON_API_KEY=

# Alpaca (free with account, market data only): https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_ENV=paper               # paper | live

# FRED (free, no key required for yfinance/fredapi via public series)
FRED_API_KEY=

# ── Runtime config ─────────────────────────────────────────────────────────
# Where Parquet caches live (default: ./data)
PINSIGHT_DATA_DIR=./data

# Where logs go (default: ./logs)
PINSIGHT_LOG_DIR=./logs

# Log level: DEBUG | INFO | WARNING | ERROR
PINSIGHT_LOG_LEVEL=INFO

# Primary underlying (start with SPY; SPX requires a Cboe license for full feed)
PINSIGHT_UNDERLYING=SPY

# Risk-free rate source (fred | manual)
PINSIGHT_RFR_SOURCE=fred
PINSIGHT_RFR_MANUAL=0.05       # used only if PINSIGHT_RFR_SOURCE=manual
